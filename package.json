{
  "name": "xwiki-publisher",
  "version": "1.2.1",
  "description": "Publish notes to XWiki and sync XWiki pages back into your vault as Markdown, using an XWiki access token.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node --env-file-if-exists=.env esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "xwiki",
    "markdown",
    "publish"
  ],
  "author": "Tunahan ALTINTOP",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "~5.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tunahanaltintop/xwiki-publisher.git"
  }
}
